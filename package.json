{
  "name": "survivor-toker",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "cap:sync": "bun run build && cap sync android",
    "android": "bun run cap:sync && cap run android",
    "replay": "bun scripts/replay.ts",
    "soak": "bun scripts/soak.ts"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.3",
    "@capacitor/core": "^8.6.3",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.9",
    "@capacitor/cli": "^8.6.3",
    "@types/bun": "^1.4.5",
    "@types/three": "^0.187.0",
    "typescript": "^7.0.2",
    "vite": "^8.4.0"
  }
}
